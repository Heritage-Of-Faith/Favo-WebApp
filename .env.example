# ─── FAVO Café — Environment Variables ────────────────────────────────────────
# Copy to .env.local for local dev. Never commit real values.
# Production: these go in Infisical (PRD v7 §9.7) — never in a committed file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# ONE direct connection (PRD v7 §9.2, AT-168) — queries, LISTEN/NOTIFY for the
# SSE streams, and the release migrator all use it. Prepared statements are on,
# so it must NOT be a PgBouncer transaction pooler (e.g. Supabase :6543).
# Production: the Postgres co-located on the Transformate host.
DATABASE_URL=postgresql://user:password@host:5432/postgres
# DATABASE_URL_SESSION is retired — the container refuses to start if it is set.

# ── Supabase (customer auth) ──────────────────────────────────────────────────
# Get from: Supabase dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Auth.js v5 (staff PIN auth) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ── Yoco Payments ─────────────────────────────────────────────────────────────
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# The jobs run in-process (src/server/jobs, AT-169); there are no cron routes and
# no CRON_SECRET. Unset = on only when NODE_ENV=production.
SCHEDULER_ENABLED=

# ── HOFMI SSO (OAuth — Phase 3, optional for now) ────────────────────────────
HOFMI_SSO_CLIENT_ID=
HOFMI_SSO_CLIENT_SECRET=
HOFMI_SSO_ISSUER=

# ── Cloudflare R2 (image storage) ────────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hofmi-favo
R2_ENDPOINT=

# ── Observability ─────────────────────────────────────────────────────────────
RAINDROP_TOKEN=
LOKI_URL=

# ── App ───────────────────────────────────────────────────────────────────────
# Set to https://favo.hofmi.net in production.
PUBLIC_BASE_URL=http://localhost:3000
# Required — never change this, all timestamps use SAST.
TZ=Africa/Johannesburg
NEXT_PUBLIC_STAGING=false
