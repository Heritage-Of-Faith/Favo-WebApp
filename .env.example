# ─── FAVO Café — Environment Variables ────────────────────────────────────────
# Copy to .env.local for local dev. Never commit real values.
# Production: these go in Infisical (PRD v7 §9.7) — never in a committed file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Transaction pooler (port 6543) — used by server actions and route handlers.
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Session pooler (port 5432) — required for LISTEN/NOTIFY (SSE queue stream).
DATABASE_URL_SESSION=postgresql://user:password@host:5432/postgres

# ── Supabase (customer auth) ──────────────────────────────────────────────────
# Get from: Supabase dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Auth.js v5 (staff PIN auth) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The fixed public origin. Production: https://favo.hofmi.net
# Required in production: unset, Auth.js treats the host as untrusted (UntrustedHost)
# and staff cannot stay signed in. It also makes Auth.js ignore the Host header.
# Leave AUTH_TRUST_HOST unset (auth.ts resolveTrustHost, go-live gap G6).
AUTH_URL=http://localhost:3000

# ── Yoco Payments ─────────────────────────────────────────────────────────────
YOCO_SECRET_KEY=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# The jobs run in-process (src/server/jobs, AT-169); there are no cron routes and
# no CRON_SECRET. Unset = on only when NODE_ENV=production.
SCHEDULER_ENABLED=

# ── Observability ─────────────────────────────────────────────────────────────
LOKI_URL=

# ── App ───────────────────────────────────────────────────────────────────────
# Set to https://favo.hofmi.net in production.
PUBLIC_BASE_URL=http://localhost:3000
# Required — never change this, all timestamps use SAST.
TZ=Africa/Johannesburg
