# ─── FAVO Café — Environment Variables ────────────────────────────────────────
# Copy to .env.local for local dev. Never commit real values.
# Production: set all of these in Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Transaction pooler (port 6543) — used by server actions and route handlers.
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Session pooler (port 5432) — required for LISTEN/NOTIFY (SSE queue stream).
DATABASE_URL_SESSION=postgresql://user:password@host:5432/postgres

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ── Yoco Payments ─────────────────────────────────────────────────────────────
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
NEXT_PUBLIC_YOCO_PUBLIC_KEY=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# Used to authenticate cron route handlers. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── HOFMI SSO (OAuth — Phase 3, optional for now) ────────────────────────────
HOFMI_SSO_CLIENT_ID=
HOFMI_SSO_CLIENT_SECRET=
HOFMI_SSO_ISSUER=

# ── Cloudflare R2 (image storage) ────────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hofmi-favo
R2_ENDPOINT=

# ── Observability ─────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_FAVO_OPS=
RAINDROP_TOKEN=
LOKI_URL=

# ── App ───────────────────────────────────────────────────────────────────────
# Set to https://favo.hofmi.org in production.
PUBLIC_BASE_URL=http://localhost:3000
# Required — never change this, all timestamps use SAST.
TZ=Africa/Johannesburg
NEXT_PUBLIC_STAGING=false
