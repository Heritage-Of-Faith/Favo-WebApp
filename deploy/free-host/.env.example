# FAVO Café - INTERIM free-host kit. Names only, safe placeholders only.
# Copy to ".env" in this folder. NEVER commit .env. NEVER paste its values into chat,
# email or tickets. Variable names follow docs/GO_LIVE_RUNBOOK.md section 4.

# ── Database (the compose "db" service; compose builds DATABASE_URL for you) ──
# Use letters and digits only (e.g. generate with `openssl rand -hex 24`):
# symbols break the connection URL.
POSTGRES_PASSWORD=CHANGE_ME

# ── Staff login ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
# The public https address people type, exactly, no trailing slash.
AUTH_URL=https://your-host
# Same value as AUTH_URL (used in password-reset links; it has no fallback).
PUBLIC_BASE_URL=https://your-host

# ── Image ─────────────────────────────────────────────────────────────────────
# Prefer a commit-sha tag over :latest so a rollback is exact.
# FAVO_IMAGE=ghcr.io/heritage-of-faith/favo-webapp:latest

# ── Customer sign-in (Supabase). BUILD-TIME values, public by design. ─────────
# Read only by `docker compose build`. A pulled CI image already has them baked in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Push notifications (optional) ─────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Card payments ─────────────────────────────────────────────────────────────
# LEAVE EMPTY. WARNING (go-live gap G5): when this is unset the payment gate is
# bypassed ("dev/simulation mode"), and the live Yoco connection is not built yet
# anyway. Sunday card sales stay on the physical Yoco machine. Do not enter a
# real key here until the runbook says so.
YOCO_SECRET_KEY=

# ── Migrations (per deploy only, then REMOVE) ─────────────────────────────────
# Comma-separated exact tags. A brand-new empty database needs all ten on the
# first start. Re-check the list with: grep -l 'favo:requires-approval' drizzle/*.sql
# FAVO_APPROVE_MIGRATION=

# ── Cloudflare named tunnel (only with: docker compose --profile tunnel) ──────
# TUNNEL_TOKEN=CHANGE_ME

# Deliberately absent: LOKI_URL (must stay unset), AUTH_TRUST_HOST (open question
# G6), TEST_AUDIT_SECRET (must stay unset), DATABASE_URL (compose builds it).
# FIRST_ADMIN_PIN is NOT stored here; it is typed once at the prompt (README step 5).
